#define OV7670_ADDR (0x21 << 1)

// OV7670 Register settings for QQVGA (160x120) YUV422 + Auto-Exposure
const uint8_t ov7670_regs[34] = {
    0x12, 0x80, // Reset all registers
    0xFF, 0xFF, // 100ms delay marker
    0x12, 0x00, // YUV output format
    0x11, 0x03, // Internal clock prescaler (/4 -> slows PCLK for reliable polling)
    0x0C, 0x04, // Enable DCW (Downsample)
    0x3E, 0x1A, // PCLK divider /4 for QQVGA
    0x70, 0x3A, // Scaling X
    0x71, 0x35, // Scaling Y
    0x72, 0x22, // Downsample by 4 (640x480 -> 160x120)
    0x73, 0xF2, // DSP scale clock divider
    0xA2, 0x02, // PCLK delay
    0x13, 0xE7, // Enable Auto Gain (AGC), Auto White Balance (AWB), Auto Exposure (AEC)
    0x14, 0x28, // Max AGC gain ceiling (8x) for clear indoor brightness
    0x55, 0x10, // Slight brightness boost
    0x56, 0x48, // Contrast boost for crisp 1-bit monochrome shading
    0x3A, 0x04, // YUYV byte order (Y brightness first, then U/V color)
    0x00, 0x00  // End marker
};

// 4x4 Bayer Matrix for high-detail grayscale dithering on 1-bit OLED
const uint8_t bayer4x4[16] = {
     15, 135,  45, 165,
    195,  75, 225, 105,
     60, 180,  30, 150,
    240, 120, 210,  90
};

uint8_t OV7670_Init(void) {
    // Check if camera responds on I2C bus (requires 4 MHz XCLK on PA8 to be ticking)
    if (HAL_I2C_IsDeviceReady(&hi2c1, OV7670_ADDR, 3, 100) != HAL_OK) {
        return 0;
    }

    for (int i = 0; ov7670_regs[i] != 0x00 || ov7670_regs[i + 1] != 0x00; i += 2) {
        if (ov7670_regs[i] == 0xFF) {
            HAL_Delay(100);
            continue;
        }
        uint8_t cmd[2] = { ov7670_regs[i], ov7670_regs[i + 1] };
        HAL_I2C_Master_Transmit(&hi2c1, OV7670_ADDR, cmd, 2, 100);
        HAL_Delay(2);
    }
    return 1;
}

void Capture_And_Display_Frame(void) {
    ssd1306_Fill(Black);

    // Pause interrupts briefly (~30ms) so SysTick doesn't drop pixels mid-row
    __disable_irq();

    // Wait for VSYNC pulse (start of new frame) with timeout safeguard
    uint32_t timeout = 2000000;
    while (((GPIOB->IDR & GPIO_PIN_0) == 0) && --timeout);
    timeout = 2000000;
    while (((GPIOB->IDR & GPIO_PIN_0) != 0) && --timeout);

    // Loop through 120 rows of QQVGA frame
    for (int y = 0; y < 120; y++) {
        timeout = 500000;
        while (((GPIOB->IDR & GPIO_PIN_1) == 0) && --timeout); // Wait for HREF high

        for (int x = 0; x < 160; x++) {
            // Byte 1: Y (Luminance/Brightness) - Sample on PCLK rising edge
            while ((GPIOB->IDR & GPIO_PIN_2) == 0);
            uint8_t y_luma = (uint8_t)(GPIOC->IDR & 0xFF);
            while ((GPIOB->IDR & GPIO_PIN_2) != 0);

            // Byte 2: U/V (Color) - Clock past and ignore
            while ((GPIOB->IDR & GPIO_PIN_2) == 0);
            while ((GPIOB->IDR & GPIO_PIN_2) != 0);

            // Crop center 128x64 window (X: 16..143, Y: 28..91) for sharpest 1:1 pixel mapping
            if (y >= 28 && y < 92 && x >= 16 && x < 144) {
                uint8_t oled_x = x - 16;
                uint8_t oled_y = y - 28;
                uint8_t threshold = bayer4x4[((oled_y & 3) << 2) | (oled_x & 3)];

                if (y_luma > threshold) {
                    ssd1306_DrawPixel(oled_x, oled_y, White);
                }
            }
        }
    }

    // Re-enable interrupts before sending frame buffer to OLED over I2C
    __enable_irq();

    ssd1306_UpdateScreen();
}
