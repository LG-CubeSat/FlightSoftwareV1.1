	cd /Users/wesleywong/Documents/GitHub/FlightSoftwareV1/build-leakcheck && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
